{
  "name": "blw-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run production:check && tsc -b && vite build && node scripts/dist-check.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run production:check && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,json}\" \"evidence/**/*.json\" \"*.{js,json,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,json}\" \"evidence/**/*.json\" \"*.{js,json,ts,html}\"",
    "production:check": "node scripts/production-check.mjs",
    "evidence:prepare": "node scripts/evidence-prepare.mjs",
    "evidence:prepare-replacement": "node scripts/evidence-prepare.mjs --replace",
    "evidence:approve": "node scripts/evidence-approve.mjs",
    "evidence:replace": "node scripts/evidence-approve.mjs --replace",
    "evidence:check": "node scripts/evidence-check.mjs",
    "smoke:artifact": "node scripts/artifact-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
